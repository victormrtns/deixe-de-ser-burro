# Non-secret local configuration
ENVIRONMENT=development
DATABASE_URL=postgresql+psycopg://USER:PASSWORD@localhost:5432/entrelinhas
PUBLIC_ORIGIN=http://localhost:5173
FILES_ROOT=./data/files
SESSION_COOKIE_NAME=entrelinhas_session
SESSION_TTL_HOURS=168
SESSION_TOUCH_INTERVAL_SECONDS=300
COOKIE_SECURE=false
MAX_COVER_BYTES=5000000
LOG_LEVEL=INFO
