# Non-secret local configuration
ENVIRONMENT=development
DATABASE_URL=postgresql+psycopg://USER:PASSWORD@localhost:5432/entrelinhas
PUBLIC_ORIGIN=http://localhost:5173
FILES_ROOT=./data/files
SESSION_COOKIE_NAME=entrelinhas_session
SESSION_TTL_HOURS=168
SESSION_TOUCH_INTERVAL_SECONDS=300
COOKIE_SECURE=false
MAX_COVER_BYTES=5000000
LOG_LEVEL=INFO

# Assistente de IA. Sem chave e com AI_GATEWAY=disabled o produto funciona
# inteiro, apenas sem assistente. A chave existe somente no backend.
AI_GATEWAY=disabled
OPENAI_API_KEY=
AI_MODEL=gpt-5-mini
# Tokens de raciocinio contam dentro de AI_MAX_OUTPUT_TOKENS.
AI_REASONING_EFFORT=low
AI_MAX_OUTPUT_TOKENS=3000
AI_MAX_CONTEXT_CHARS=120000
AI_MAX_MARKDOWN_CHARS=60000
AI_DEVELOPMENT_BUDGET_USD=2.00
AI_MANUAL_SMOKE_BUDGET_USD=0.25

# Docker Compose (local)
POSTGRES_USER=entrelinhas
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=entrelinhas
PUBLIC_ORIGIN=http://127.0.0.1:5173
